{;; resources and corpora are on the classpath so migratus and the corpus
 ;; loader can find their files. test is not -- it belongs to the :test alias.
 :paths ["src" "resources" "corpora"]

 ;; Runtime, not tooling: a fresh clone migrates its own database on first run.
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        migratus/migratus {:mvn/version "1.6.7"}}

 :aliases
 {;; clj -M:nrepl  start the long-lived REPL; leave it running
  ;; nREPL picks a free port and writes it to .nrepl-port, which is how the
  ;; editor finds it. cider-nrepl looks optional and is not: completion and
  ;; the default pretty-printer live there, and both fail silently without it.
  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                cider/cider-nrepl {:mvn/version "0.62.2"}}
   :main-opts ["-m" "nrepl.cmdline"
               "--middleware" "[cider.nrepl/cider-middleware]"]
   ;; sqlite-jdbc loads a native library. Without this, JDK 25 warns on every
   ;; start that "restricted methods will be blocked in a future release".
   ;; :jvm-opts is per alias, so every alias that opens the database repeats it.
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; clj -M:nrepl:portal  the same REPL with the data inspector added
  ;; No :main-opts here, so :nrepl keeps the process. Open it with:
  ;;   (require '[portal.api :as p]) (add-tap #'p/submit) (p/open)
  :portal
  {:extra-deps {djblue/portal {:mvn/version "0.67.2"}}}

  ;; clj -X:test. Both entry points declared because the runner supports both.
  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; clj -X:migrate       apply every pending migration
  ;; clj -X:rollback      undo the most recently applied one
  ;; clj -X:pending-list  print the migrations that have not run
  :migrate      {:exec-fn liesl.db/migrate      :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :rollback     {:exec-fn liesl.db/rollback     :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :pending-list {:exec-fn liesl.db/pending-list :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}}}

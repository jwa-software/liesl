{;; `resources` and `corpora` are on the classpath so migratus and the corpus
 ;; loader can find their files. `test` is not -- it belongs to the :test alias.
 :paths ["src" "resources" "corpora"]

 ;; Runtime, not tooling: a fresh clone migrates its own database on first run.
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        migratus/migratus {:mvn/version "1.6.7"}
        org.jsoup/jsoup {:mvn/version "1.23.2"}
        org.apache.lucene/lucene-core {:mvn/version "10.5.1"}
        org.apache.lucene/lucene-queryparser {:mvn/version "10.5.1"}
        org.apache.lucene/lucene-highlighter {:mvn/version "10.5.1"}
        ;; The MCP server: core plus its Jackson 3 JSON binding. It logs through
        ;; slf4j, and slf4j-simple sends that to stderr, which keeps stdout for
        ;; the protocol and still shows the SDK's own errors.
        io.modelcontextprotocol.sdk/mcp {:mvn/version "2.0.1"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.17"}}

 :aliases
 {;; clj -M:nrepl  start the long-lived REPL; leave it running
  ;; nREPL picks a free port and writes it to `.nrepl-port`, which is how the
  ;; editor finds it. cider-nrepl looks optional and is not: completion and
  ;; the default pretty-printer live there, and both fail silently without it.
  :nrepl
  {:extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                cider/cider-nrepl {:mvn/version "0.62.2"}}
   :main-opts ["-m" "nrepl.cmdline"
               "--middleware" "[cider.nrepl/cider-middleware]"]
   ;; sqlite-jdbc loads a native library and lucene-core calls one. Without
   ;; this, JDK 25 warns on every start that "restricted methods will be
   ;; blocked in a future release". :jvm-opts is per alias, so every alias
   ;; that opens the database or the index repeats it.
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; clj -M:nrepl:portal  the same REPL with the data inspector added
  ;; No :main-opts here, so :nrepl keeps the process. Open it with:
  ;;   (require '[portal.api :as p]) (add-tap #'p/submit) (p/open)
  :portal
  {:extra-deps {djblue/portal {:mvn/version "0.67.2"}}}

  ;; clj -X:test. Both entry points declared because the runner supports both.
  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test
   ;; Two logging files keep test runs quiet: this one for java.util.logging
   ;; (Lucene), and test/simplelogger.properties, which slf4j-simple finds on
   ;; the classpath by itself (Migratus). See the comments in each.
   :jvm-opts ["--enable-native-access=ALL-UNNAMED"
              "-Djava.util.logging.config.file=test/logging.properties"]}

  ;; clj -M:cljfmt check  report the files .cljfmt.edn would change
  ;; clj -M:cljfmt fix    change them
  :cljfmt
  {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
   :main-opts  ["-m" "cljfmt.main"]}

  ;; clj -X:migrate       apply every pending migration
  ;; clj -X:rollback      undo the most recently applied one
  ;; clj -X:pending-list  print the migrations that have not run
  :migrate      {:exec-fn liesl.db/migrate      :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :rollback     {:exec-fn liesl.db/rollback     :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}
  :pending-list {:exec-fn liesl.db/pending-list :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; clj -X:fetch :corpus fhir                       fetch every version of every archive source
  ;; clj -X:fetch :corpus fhir :versions '["R4"]'    one version only
  ;; clj -X:fetch :corpus fhir :pause-ms 2000        two seconds between requests instead of one
  :fetch        {:exec-fn liesl.fetch/fetch       :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; clj -X:parse :corpus fhir                       parse every fetched archive into document rows
  ;; clj -X:parse :corpus fhir :versions '["R4"]'    one version only
  :parse        {:exec-fn liesl.parse/parse       :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; clj -X:index                                    write every document row not yet in the index
  :index        {:exec-fn liesl.index/index       :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; clj -X:search :q birthTime                      the pages that answer a question, best first
  ;; clj -X:search :q '"patient birth"' :version R4  several words are quoted; one version only
  :search       {:exec-fn liesl.query/search      :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}

  ;; clojure -M:mcp   serve the index to an agent over MCP on stdin and stdout;
  ;;                  what `claude mcp add liesl -- clojure -M:mcp` runs
  :mcp          {:main-opts ["-m" "liesl.mcp"]    :jvm-opts ["--enable-native-access=ALL-UNNAMED"]}}}

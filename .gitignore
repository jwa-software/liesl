# ---> Rust
# Compiled artefacts. The debug and release profiles both live under target/,
# so this one entry covers them.
/target

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Cargo.lock is deliberately absent from this list. Commit it for binaries and
# for workspaces that produce one; ignore it for libraries, where pinning
# dependencies would hide breakage from downstream users. In a library, add:
#   /Cargo.lock

# Coverage instrumentation and reports (cargo-llvm-cov, grcov, tarpaulin)
*.profraw
*.profdata
/coverage/
lcov.info
tarpaulin-report.html
cobertura.xml

# Profiling output (cargo-flamegraph, perf)
perf.data
perf.data.old
flamegraph.svg


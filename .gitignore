# Combined base ignore file.
#
# Patterns shared between languages (*.o, *.a, *.so, ...) are listed once, under
# the section that owns them, and cross-referenced from the others. Patterns
# that appear in the upstream github/gitignore templates but are too broad for a
# file shared across every language are listed at the bottom rather than
# silently dropped.

# ============================================================================
# Languages and runtimes
# ============================================================================

# ---> C / C++
# This section owns the object, library and executable patterns that the OCaml,
# Elixir / Erlang and Lua sections also depend on.

# Object and intermediate files
*.o
*.ko
*.obj
*.elf
*.slo
*.lo
*.su

# Precompiled headers
*.gch
*.pch

# Static and shared libraries
*.a
*.la
*.lai
*.lib
*.so
*.so.*
*.dylib
*.dll

# Linker output
*.ilk
*.map
*.exp
*.def

# Executables. `a.out` rather than `*.out`, which is far too broad.
a.out
*.exe
*.app
*.hex

# Debug symbols (*.pdb is listed in the Rust section)
*.dSYM/
*.idb

# Linux kernel modules. `*.mod` is omitted, and `.*.cmd` is used in place of
# `*.cmd`; see the omissions note at the bottom of this file.
*.mod.c
.*.cmd
.tmp_versions/
modules.order
Module.symvers
dkms.conf

# ---> Clojure / JVM
*.class
pom.xml.asc

# Jars, except the Gradle wrapper, which is meant to be committed
*.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Leiningen
.lein-deps-sum
.lein-repl-history
.lein-plugins/
.lein-failures

# tools.deps classpath cache
.cpcache/

# nREPL and shadow-cljs
.nrepl-port
.shadow-cljs/

# clj-kondo and clojure-lsp, as driven by the Neovim LSP and lint plugins.
# The contents form is required rather than `.clj-kondo/`: git does not descend
# into an excluded directory, so the directory form would make these negations
# impossible and lock the tracked config files out of the repo.
# Note this also ignores library configs imported by `clj-kondo --copy-configs`.
.clj-kondo/*
!.clj-kondo/config.edn
.lsp/*
!.lsp/config.edn

# ---> Elixir / Erlang
*.beam
*.ez
*.plt
erl_crash.dump
.eunit
.rebar/
ebin/
/deps/
/cover/
/.fetch

# ElixirLS
.elixir_ls/

# Secrets kept out of config
/config/*.secret.exs

# (_build/ is listed in the OCaml section)

# ---> Haskell
# Cabal's v2 build output. Every package and every build product in the
# project lives under this one directory, so a single entry covers them all.
dist-newstyle/

# Written by `cabal configure`; machine-specific. cabal.project itself is
# deliberately not ignored, being tracked project configuration like the
# .cabal file.
cabal.project.local
cabal.project.local~

# Written by `cabal build` when GHC environment files are enabled
.ghc.environment.*

# Stack
.stack-work/

# Interface and extended-interface files. *.o and the library artefacts are
# listed in the C / C++ section; the cabal v1 `dist/` in the Node section.
*.hi
*.dyn_hi
*.dyn_o
*.hie

# Profiling and hpc coverage output
*.prof
*.tix
.hpc/

# ---> Lua
luac.out
*.src.rock
*.rock

# (object and library artefacts are listed in the C / C++ section)

